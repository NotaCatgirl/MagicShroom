# Copy to backend/.env (git-ignored) and fill in the backend and Android settings below.
# Local run:  set -a && . ./backend/.env && set +a && cd backend && ./gradlew bootRun
# Docker:     docker compose up
#
# Supabase session pooler (port 5432) suits a long-running server; see docs/render-deployment.md.
DATABASE_URL=jdbc:postgresql://your-pooler-host:5432/postgres?sslmode=require
DATABASE_USER=postgres.your-project-ref
DATABASE_PASSWORD=your-database-password
SUPABASE_URL=https://your-project-ref.supabase.co

# Public Android sign-in setting; the app reads this together with SUPABASE_URL.
SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Optional, server-only: lets "delete user" also delete the Supabase Auth login.
# Supabase dashboard -> Project Settings -> API Keys -> secret key. Never put it in the app.
SUPABASE_SECRET_KEY=
